# Do not put real keys into this example. Copy to .env.
BOT_QQ=
# Optional custom QQ NT executable path, for example C:\Program Files\Tencent\QQNT\QQ.exe
QQ_EXECUTABLE=
PRIVATE_USER_QQ=
# Private group-management controller: PRIVATE_USER_QQ, or first PRIVATE_USER_QQS if empty
# Disabled by default; only explicit commands and whitelisted groups are supported
GROUP_MANAGEMENT_ENABLED=false
# Group owner/admin: @bot 禁言 @member minutes; omit minutes to unmute; independent of private controller
GROUP_ADMIN_COMMANDS_ENABLED=false
# Automatic consecutive-message moderation, independent of private manual commands
GROUP_ANTI_SPAM_ENABLED=false
GROUP_ANTI_SPAM_COUNT=5
GROUP_ANTI_SPAM_WINDOW_SECONDS=10
GROUP_ANTI_SPAM_MUTE_MINUTES=5
# Empty value disables the notice; sent only after confirmed successful mute
GROUP_ANTI_SPAM_REPLY="你话太多了！"
# Optional comma-separated whitelist; overrides PRIVATE_USER_QQ when set
PRIVATE_USER_QQS=
GROUP_QQ=
# Optional comma-separated group whitelist; overrides GROUP_QQ when set
GROUP_QQS=
# Defaults to PRIVATE_USER_QQ when empty
ADMIN_QQ=
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
# Optional extra profiles, e.g. alt,backup (default always uses settings above)
MODEL_PROFILES=
# Fill every required field before adding alt to MODEL_PROFILES.
MODEL_ALT_NAME=
MODEL_ALT_BASE_URL=
MODEL_ALT_API_KEY=
MODEL_ALT_PRICE_INPUT_CNY_PER_MILLION=
MODEL_ALT_PRICE_OUTPUT_CNY_PER_MILLION=
MODEL_ALT_PRICE_CACHE_HIT_CNY_PER_MILLION=
MODEL_ALT_PRICE_VERIFIED_DATE=
MODEL_ALT_SUPPORTS_VISION=false
MODEL_ALT_SUPPORTS_SEARCH=false
MODEL_ALT_SEND_THINKING=false
# Required if SUPPORTS_VISION=true: conservative image input token reserve per image
MODEL_ALT_IMAGE_INPUT_RESERVE_TOKENS=
MODEL_ALT_MAX_OUTPUT_TOKENS=1024
MODEL_ALT_CONTEXT_INPUT_TOKENS=16000
DAILY_BUDGET_CNY=1
# REQUIRED: verified CNY per million tokens; do not guess prices.
PRICE_INPUT_CNY_PER_MILLION=
PRICE_OUTPUT_CNY_PER_MILLION=
PRICE_VERIFIED_DATE=
# Optional: cache-hit input price. Empty uses 1/50 of the miss price (DeepSeek's
# ratio); providers that do not report cache usage never need it.
PRICE_CACHE_HIT_CNY_PER_MILLION=
# Off-peak multiplier applied to all three prices (DeepSeek: off-peak is half)
PRICE_OFFPEAK_RATIO=0.5
# Optional extra statutory holidays for peak/off-peak pricing, comma separated
# YYYY-MM-DD. The built-in table already covers the published year.
COST_HOLIDAYS=
MAX_OUTPUT_TOKENS=1024
CONTEXT_INPUT_TOKENS=16000
MODEL_TIMEOUT_MS=60000
GROUP_CLEAR_HOURS=72
DATABASE_PATH=data/autochat.sqlite
# 留空时使用两层人格：personas/behavior.md（行为层，需重启）+ 启用的人格卡（即时）
# 填写后该字符串独占最高优先级，完全忽略 personas/ 目录（向后兼容旧配置）
SYSTEM_PROMPT=
# 人格文件目录；控制台「人格」页会在这里读写 behavior.md 与 characters/*.md
PERSONA_DIR=personas
# 未在控制台选择人格卡时默认启用的卡名；留空表示使用 src/persona.js 的内置默认
PERSONA_DEFAULT=
# Optional comma-separated input/output block terms (not full moderation)
BLOCK_TERMS=
# Optional comma-separated keywords; trigger normal model replies for full messages
TRIGGER_TERMS=
# true also matches rules in the allowed group without mentioning the bot
GROUP_KEYWORD_WITHOUT_AT=false
# Native DeepSeek web search; only explicit /搜索 queries, no history sent to search
WEB_SEARCH_ENABLED=false
# Opt in to automatic search for weather/news/latest information; private and group triggers unchanged
WEB_SEARCH_AUTO_ENABLED=false
# Extra reserve for search result input and native summarization (not an upstream hard cap)
WEB_SEARCH_INPUT_RESERVE_TOKENS=64000
WEB_SEARCH_DAILY_LIMIT=50
# 图片只用于当次识别，不保存原图；original 保留细节，low 较省费用
VISION_ENABLED=false
VISION_DETAIL=original
# 本机只读控制台：仅绑定 127.0.0.1，所有 /api 需要令牌
CONSOLE_ENABLED=false
CONSOLE_PORT=3200
# 留空则首次启动自动生成，写入 runtime/console-token.txt（至少 16 位可见 ASCII）
CONSOLE_TOKEN=
# 拟人化群友（Phase 3）：默认关闭时群里仍然只 @ 才回
SOCIAL_ENABLED=false
# 相关度阈值：低于它保持沉默（不调用模型、不花钱）；可在控制台「仿真」页运行时调整
SOCIAL_THRESHOLD=6
# 两次主动发言的最小间隔（秒）与每个群的每日主动发言条数上限
SOCIAL_COOLDOWN_SECONDS=45
SOCIAL_DAILY_LIMIT=20
# 送给模型的最近群消息条数；一条回复最多拆成几条消息
SOCIAL_CONTEXT_MESSAGES=12
SOCIAL_MAX_CHUNKS=3
# 分条发送前/之间的随机停顿（毫秒）
SOCIAL_MIN_DELAY_MS=900
SOCIAL_MAX_DELAY_MS=2600
# 群消息流水保留时长（小时），过期由维护任务清理
SOCIAL_MESSAGE_TTL_HOURS=24
# 群里被叫到就会加分；BOT_NICKNAMES 为逗号分隔的别名
BOT_NAME=
BOT_NICKNAMES=
# 群聊黑话词库（Phase 4）：默认关闭时不注入任何内容，也不会主动抽取
SLANG_ENABLED=false
# 最多注入多少条已确认词条（上限 30）；候选必须在控制台人工点「确认」才会生效
SLANG_INJECT_MAX=20
# 一次抽取扫描最近多少条群消息
SLANG_EXTRACT_MESSAGES=120
# 定时自动抽取：默认关闭，因为它在无人按键的情况下花预算
SLANG_AUTO_EXTRACT=false
# 自动抽取的最小间隔（小时），不影响手动触发
SLANG_EXTRACT_INTERVAL_HOURS=12
