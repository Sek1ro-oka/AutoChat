# Do not put real keys into this example. Copy to .env.
BOT_QQ=
# Optional custom QQ NT executable path, for example C:\Program Files\Tencent\QQNT\QQ.exe
QQ_EXECUTABLE=
PRIVATE_USER_QQ=
# Private group-management controller: PRIVATE_USER_QQ, or first PRIVATE_USER_QQS if empty
# Disabled by default; only explicit commands and whitelisted groups are supported
GROUP_MANAGEMENT_ENABLED=false
# Automatic consecutive-message moderation, independent of private manual commands
GROUP_ANTI_SPAM_ENABLED=false
GROUP_ANTI_SPAM_COUNT=5
GROUP_ANTI_SPAM_WINDOW_SECONDS=10
GROUP_ANTI_SPAM_MUTE_MINUTES=5
# Empty value disables the notice; sent only after confirmed successful mute
GROUP_ANTI_SPAM_REPLY="你话太多了！"
# Optional comma-separated whitelist; overrides PRIVATE_USER_QQ when set
PRIVATE_USER_QQS=
GROUP_QQ=
# Optional comma-separated group whitelist; overrides GROUP_QQ when set
GROUP_QQS=
# Defaults to PRIVATE_USER_QQ when empty
ADMIN_QQ=
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
DAILY_BUDGET_CNY=1
# REQUIRED: verified CNY per million tokens; do not guess prices.
PRICE_INPUT_CNY_PER_MILLION=
PRICE_OUTPUT_CNY_PER_MILLION=
PRICE_VERIFIED_DATE=
MAX_OUTPUT_TOKENS=1024
CONTEXT_INPUT_TOKENS=16000
MODEL_TIMEOUT_MS=60000
GROUP_CLEAR_HOURS=72
DATABASE_PATH=data/autochat.sqlite
# Empty uses the built-in tsundere persona in src/persona.js
SYSTEM_PROMPT=
# Optional comma-separated input/output block terms (not full moderation)
BLOCK_TERMS=
# Optional comma-separated keywords; trigger normal model replies for full messages
TRIGGER_TERMS=
# true also matches rules in the allowed group without mentioning the bot
GROUP_KEYWORD_WITHOUT_AT=false
# Native DeepSeek web search; only explicit /搜索 queries, no history sent to search
WEB_SEARCH_ENABLED=false
# Extra reserve for search result input and native summarization (not an upstream hard cap)
WEB_SEARCH_INPUT_RESERVE_TOKENS=64000
WEB_SEARCH_DAILY_LIMIT=50
# 图片只用于当次识别，不保存原图；original 保留细节，low 较省费用
VISION_ENABLED=false
VISION_DETAIL=original
